  "53": {
    "side_m01_060_001": {
      "message": "犯人が情報を盗み出していた手段は……",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 53
    }
  },
  "54": {
    "side_m01_060_002": {
      "message": "盗聴器を呼び寄せるために使っていた手段。それを推測するための痕跡とは？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 104
    }
  },
  "55": {
    "side_m01_060_003": {
      "message": "現場から逃げ去った盗聴犯が落としていった証拠とは？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 54
    }
  },
  "56": {
    "side_m01_060_004": {
      "message": "盗聴器を仕掛けられた猫を逃がすために犯人が使っていた手段は？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 55
    }
  },
  "57": {
    "side_m01_060_005": {
      "message": "これまでの推理から結論できることとは？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 56
    }
  },
  "58": {
    "m01_03100": {
      "message": "理事長に何を聞こう？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 57
    }
  },
  "59": {
    "m01_04300_1": {
      "message": "なんか疑り深い先生だな。どう答えて切り抜けよう？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 58
    }
  },
  "60": {
    "m01_04300_2": {
      "message": "この学校の理事長の名前……　なんだっけ？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 59
    }
  },
  "61": {
    "m01_05000": {
      "message": "この映像の中にいる、イジメを止められる存在。それがなにかといえば……",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 60
    }
  },
  "62": {
    "m02_00200": {
      "message": "理事長が、今になってイジメに取り組みだしたきっかけとは？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 61
    }
  },
  "63": {
    "m04_01300": {
      "message": "警察がまだ持ってない証拠を突きつけてこっちの実力を見せてやろう。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 62
    }
  },
  "64": {
    "m04_01600": {
      "message": "この現場で警察が調べたことを聞き出そう",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 101
    }
  },
  "65": {
    "m04_04300": {
      "message": "警察でも手に入れられなかった証拠を突きつけよう",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 102
    }
  },
  "66": {
    "m05_00600_1": {
      "message": "「痴漢のアリバイ」か「殺人動画」のどちらかはフェイクだ",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 103
    }
  },
  "67": {
    "m05_00600_2": {
      "message": "江原が御子柴を殺してたなら、痴漢の方の証拠には何か細工の痕があるかも。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 116
    }
  },
  "68": {
    "m05_01800": {
      "message": "間宮由衣の気を引いてドアを開けてもらうには？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 117
    }
  },
  "69": {
    "m05_01900": {
      "message": "今の間宮由衣の話と矛盾する証拠とは？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 63
    }
  },
  "70": {
    "M05_02200_1": {
      "message": "江原の殺人動画をネットに流出させたのは誰だ？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 64
    }
  },
  "71": {
    "M05_02200_2": {
      "message": "江原は、つねに防犯カメラで捉えられていたわけじゃない。その証拠は？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 65
    }
  },
  "72": {
    "M05_02300_1": {
      "message": "御子柴殺しが仕組まれていたものなら、この可能性が考えられるよな？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 66
    }
  },
  "73": {
    "M05_02300_2": {
      "message": "「黒河学園」といえば最近耳にしたぞ。それってたしか……",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 67
    }
  },
  "74": {
    "m06_01400_1": {
      "message": "この人たちがＲＫかどうか、探りを入れてみましょう",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 68
    }
  },
  "75": {
    "m06_01400_2": {
      "message": "だいぶ怪しまれてますね。マズイです、何と名乗りましょう？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 69
    }
  },
  "76": {
    "M08_00200": {
      "message": "澤先生が持っていた黒河学園の卒業アルバム。こいつをどうするか……？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 70
    }
  },
  "77": {
    "M09_00500": {
      "message": "桑名は偽名を使っていた。そこからどうやって話を掘り下げようか。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 71
    }
  },
  "78": {
    "g09_010": {
      "message": "旧姓が鈴木だった女子生徒。１３年たった今の彼女の名前は……？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 72
    }
  },
  "79": {
    "M09_01200_1": {
      "message": "１３年前の桑名が教職を追われた直後に持っていた「目的」とは？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 73
    }
  },
  "80": {
    "M09_01200_2": {
      "message": "これまでの証拠の中に「川井の知人たち」の手がかりがあったはずだ。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 74
    }
  },
  "81": {
    "M09_01700_1": {
      "message": "何から聞こう。いきなり怒らせるような質問はまずいかもな。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 75
    }
  },
  "82": {
    "M09_01700_2": {
      "message": "桑名が間宮由衣のことを忘れているわけがない。そのことを示す証拠は？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 76
    }
  },
  "83": {
    "m10_00500": {
      "message": "まだ疑問の残る証拠品を間宮由衣につきつけよう。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 77
    }
  },
  "84": {
    "m10_00900_1": {
      "message": "御子柴を痛めつけたあと江原は何をしたか。それを示す証拠は？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 79
    }
  },
  "85": {
    "m10_00900_2": {
      "message": "江原は、御子柴のイジメがあった事実を、どこから聞いて知った？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 80
    }
  },
  "86": {
    "m10_01100": {
      "message": "源田先生が迷っている。なんて声をかけよう？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 81
    }
  },
  "87": {
    "m10_02600_1": {
      "message": "桑名を追っている連中の正体とは？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 82
    }
  },
  "88": {
    "m10_02600_2": {
      "message": "公安が桑名を追う理由はなんだ？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 83
    }
  },
  "89": {
    "m11_00200": {
      "message": "楠本玲子に何を聞こう？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 84
    }
  },
  "90": {
    "m11_00600_1": {
      "message": "江原の控訴にあたって、こっちの姿勢を検事に伝えてやろう。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 85
    }
  },
  "91": {
    "m11_00600_2": {
      "message": "痴漢を証拠づけた防犯映像には実は大きな穴がある。それを示す証拠は？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 86
    }
  },
  "92": {
    "m11_01000": {
      "message": "さおりさんのメイクはさおりさんに任せるべきか、それとも……？\n※さおりさんに任せた場合は前回と同じ服装になります。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 87
    }
  },
  "93": {
    "m11_01700_1": {
      "message": "不本意ながら星野君を褒めて場を盛り上げないと……！",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 88
    }
  },
  "94": {
    "m11_01700_2": {
      "message": "早く話をそらすんです、でもいったい何をすれば……!?",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 89
    }
  },
  "95": {
    "m13_00700": {
      "message": "江原は、御子柴殺しの証拠を残している？　だとしたらそれは何だ？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 90
    }
  },
  "96": {
    "m13_01000": {
      "message": "異人町でみんなが聞き込んできてくれた情報を集めて整理しよう。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 91
    }
  },
  "97": {
    "m13_01700": {
      "message": "江原が、痴漢の替え玉と入れ替わった可能性を示す証拠は？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 92
    }
  },
  "98": {
    "m13_01800_1": {
      "message": "痴漢被害者の間宮由衣について、俺はどう言えばいい？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 93
    }
  },
  "99": {
    "m13_01800_2": {
      "message": "江原にシラを切らせたりはしない。なにか突破口を見つけるんだ……！",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 94
    }
  },
  "100": {
    "m13_01800_3": {
      "message": "江原と桑名が過去に接触していたことを示す証拠とは？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 95
    }
  },
  "101": {
    "m02_00800": {
      "message": "どうやってこの状況を切り抜けよう？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 96
    }
  },
  "102": {
    "m02_00820": {
      "message": "天沢への提案とは？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 97
    }
  },
  "103": {
    "m02_00830": {
      "message": "天沢さんに話を聞いてみよう。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 98
    }
  },
  "104": {
    "m02_00840": {
      "reARMP_isValid": "0",
      "reARMP_rowIndex": 99
    }
  },
  "105": {
    "drama_m01_200": {
      "message": "西園にパパ活女子の件について聞いてみる？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 100
    }
  },
  "106": {
    "drama_m02_260": {
      "message": "小鳥遊に事情を聞いてみよう。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 256
    }
  },
  "107": {
    "drama_m02_265": {
      "message": "天沢たちと糸倉古都子のもとに向かう？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 257
    }
  },
  "108": {
    "drama_m02_270": {
      "message": "どうやって糸倉を説得する？",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 258
    }
  },
  "109": {
    "drama_m02_280": {
      "message": "裏サイトについて天沢に話を聞こう。",
      "reARMP_isValid": "1",
      "reARMP_rowIndex": 259
    }
  },
